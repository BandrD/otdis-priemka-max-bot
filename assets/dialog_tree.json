    "priemka_docs": {
      "id": "priemka_docs",
      "title": "Необходимые документы",
      "parent": "priemka",
      "payload": {
        "type": "text",
        "text": "• Паспорт (оригинал и 2 копии)\n• Аттестат (оригинал / заверенная копия + 2 обычные копии)\n• Фото 3×4 — 4 шт. (подписать на обороте)\n• Медицинская справка (форма 086) с флюорографией за 2025 год\n• СНИЛС (2 копии)\n• Прививочный сертификат (оригинал и копия)\n• Медицинский полис (2 копии)\n• Документы об инвалидности или ОВЗ (если есть)\n• Заключение ПМК для лиц с ОВЗ и инвалидов\n• Документы о льготах (если применимы)\n• ИНН (копия)"
      }
    },
    "priemka_contacts": {
